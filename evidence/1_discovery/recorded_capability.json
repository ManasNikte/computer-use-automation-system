  "recovery_rules": [
    {
      "action": {
        "kind": "click",
        "locator": {
          "description": "the Acknowledge link on the maintenance notice",
          "strategies": [
            {
              "frame": "name=mainframe",
              "kind": "role_name",
              "name": "Acknowledge",
              "role": "link"
            },
            {
              "frame": "",
              "kind": "role_name",
              "name": "Acknowledge",
              "role": "link"
            },
            {
              "frame": "name=mainframe",
              "kind": "text",
              "value": "Acknowledge"
            }
          ]
        }
      },
      "description": "A scheduled-maintenance interstitial can appear on any screen. Acknowledge it and carry on.",
      "detect": {
        "description": "the maintenance interstitial is covering the working area",
        "kind": "text_present",
        "value": "Scheduled Maintenance Notice"
      },
      "max_attempts": 1,
      "name": "dismiss_maintenance_notice"
    },
    {
      "action": {
        "_comment": [
          "Re-execute the steps from here up to (not including) the one that was",
          "interrupted, then retry it. '@first' means the whole prefix, which for",
          "this app re-runs sign-in and re-navigates to the record.",
          "",
          "The executor REFUSES this recovery if any step in the prefix is",
          "irreversible, and escalates instead. Silently replaying a prefix that",
          "contains a commit would post the transaction twice -- a recovery",
          "mechanism must never be able to cause the thing it is recovering from."
        ],
        "kind": "restart_from_step",
        "step_id": "@first"
      },
      "description": "The session can expire mid-flow. Re-run the sign-in steps and resume where we left off.",
      "detect": {
        "description": "the application bounced us back to the sign-in screen",
        "kind": "text_present",
        "value": "Your session has expired"
      },
      "max_attempts": 1,
      "name": "reauthenticate_on_session_expiry"
    },
    {
      "action": {
        "delay_ms": 1500,
        "kind": "retry_step"
      },
      "description": "The application is intermittently slow. Wait and re-attempt the step before calling it a failure.",
      "detect": {
        "description": "engaged when the surface times out, not by anything visible on screen",
        "kind": "on_timeout",
        "value": ""
      },
      "max_attempts": 2,
      "name": "retry_transient_slow_load"
    }
  ],
